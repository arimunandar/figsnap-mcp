{
  "name": "figsnap-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A Figma plugin and a local daemon that put the open Figma file behind MCP tools: extract a node as PNG, React, HTML and CSS, read and edit the canvas, and keep a saved set of components — with no relay, no account and no network beyond loopback.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "figsnap-mcp-daemon": "agent/index.mjs",
    "figsnap-mcp": "agent/mcp-stdio.mjs"
  },
  "files": [
    "agent",
    "shared",
    "manifest.json",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "daemon": "node agent/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.136.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
